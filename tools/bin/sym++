#!/usr/bin/env bash
set -euo pipefail

image="${AGENTIC_FUZZ_SYMCC_IMAGE:-eurecoms3/symcc:latest}"
platform="${AGENTIC_FUZZ_SYMBOLIC_PLATFORM:-linux/amd64}"
cwd="$(pwd)"
project_root="${CLAUDE_PROJECT_DIR:-}"
docker_bin="${DOCKER_BIN:-}"
if [ -z "${docker_bin}" ]; then
  docker_bin="$(command -v docker || true)"
fi
for candidate in /opt/homebrew/bin/docker /usr/local/bin/docker /usr/bin/docker; do
  if [ -z "${docker_bin}" ] && [ -x "${candidate}" ]; then
    docker_bin="${candidate}"
  fi
done
if [ -z "${docker_bin}" ]; then
  echo "docker not found" >&2
  exit 127
fi
env_args=()
for name in SYMCC_OUTPUT_DIR SYMCC_INPUT_FILE SYMCC_AFL_COVERAGE_MAP; do
  if [ -n "${!name:-}" ]; then
    env_args=(-e "${name}" "${env_args[@]}")
  fi
done
mount_args=(-v "${cwd}:${cwd}" -v "/tmp:/tmp")
if [ -n "${project_root}" ] && [ -d "${project_root}" ] && [ "${project_root}" != "${cwd}" ]; then
  mount_args=(-v "${project_root}:${project_root}" "${mount_args[@]}")
fi

exec "${docker_bin}" run --platform "${platform}" --rm \
  "${env_args[@]}" \
  "${mount_args[@]}" \
  -w "${cwd}" \
  "${image}" \
  /symcc_build/sym++ "$@"
